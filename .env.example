# ==============================================================
# Smart Supermarket with Smart Trolley using RAG
# ==============================================================

# Backend Server Configuration
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Supermarket Store Configuration
STORE_NAME="SmartMart Supermarket"
DEFAULT_BUDGET=2000.0

# LLM / Nexus API Configuration
# Provide your provider endpoint, model name and API key below.
# If no key is set or the API is offline, system automatically runs in DEMO FALLBACK MODE.
NEXUS_API_KEY=
NEXUS_BASE_URL=https://api.nexus.example.com/v1
NEXUS_MODEL=nexus-chat-v1

# Vector Search & RAG Thresholds
EMBEDDING_MODEL=all-MiniLM-L6-v2
RELEVANCE_THRESHOLD=0.20
TOP_K=4
